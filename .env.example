# Supabase — required for data persistence
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only, bypasses RLS
# NEVER expose this to the client/browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Discord webhook for contact form notifications
DISCORD_WEBHOOK_URL=

# Optional: Telegram bot for contact form notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: AI generation for qEEG "Case of the Day" (OpenWebUI -> Claude).
# OpenAI-compatible endpoint; leave blank to disable AI drafting.
OPENWEBUI_BASE_URL=
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=

# Optional: AI IMAGE generation (original synthetic case images, Tier 3).
# OpenWebUI mangles generated images on relay, so point these DIRECTLY at the
# OpenClaw $imagegen bridge (which returns delta.images). Fall back to the
# OPENWEBUI_* vars above only if that endpoint is a direct-to-bridge URL.
OPENWEBUI_IMAGE_BASE_URL=
OPENWEBUI_IMAGE_API_KEY=
OPENWEBUI_IMAGE_MODEL=cipher-openclaw
OPENWEBUI_IMAGE_TIMEOUT_MS=240000
