{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedquest.org/schemas/qbank/question.schema.json",
  "title": "PedQuEST qEEG question",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "title", "domain", "population", "setting", "difficulty", "bloom", "learning_objective", "stem", "question_type", "options", "explanation", "key_points", "references", "image", "metadata"],
  "properties": {
    "id": { "type": "string", "pattern": "^PQ-[A-Z]-[0-9]{3}$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "pending_review", "approved", "published", "archived"] },
    "title": { "type": "string", "maxLength": 90 },
    "domain": { "enum": ["foundations", "seizure_detection", "background_terminology", "clinical_prognosis", "monitoring_practice", "special_populations_pitfalls"] },
    "topics": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
    "population": { "enum": ["neonate", "infant", "child", "adolescent", "mixed"] },
    "setting": { "enum": ["NICU", "PICU", "CICU", "ECMO", "ED", "EMU", "OR", "other"] },
    "difficulty": { "enum": ["introductory", "intermediate", "advanced"] },
    "bloom": { "enum": ["recall", "interpretation", "application", "analysis"] },
    "learning_objective": { "type": "string", "maxLength": 240 },
    "stem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vignette", "image_caption", "lead_in"],
      "properties": {
        "vignette": { "type": "string", "minLength": 200, "maxLength": 1100 },
        "image_caption": { "type": "string", "maxLength": 400 },
        "lead_in": { "type": "string", "maxLength": 200 }
      }
    },
    "question_type": { "enum": ["multiple_choice", "point_to_feature"] },
    "options": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "text", "correct", "rationale"],
        "properties": {
          "key": { "enum": ["A", "B", "C", "D", "E"] },
          "text": { "type": "string", "maxLength": 140 },
          "correct": { "type": "boolean" },
          "rationale": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "point_to_feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "target_event", "target_panel"],
      "properties": {
        "instruction": { "type": "string", "maxLength": 200 },
        "target_event": { "type": "integer", "description": "index into image.spec.events whose location is the correct region" },
        "target_panel": { "type": "string", "description": "panel name (qeeg_panel) or 'page' (eeg_page)" },
        "tolerance": { "type": "number", "minimum": 0, "maximum": 0.2, "default": 0.04 }
      }
    },
    "explanation": { "type": "string", "minLength": 500, "maxLength": 2200 },
    "key_points": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "maxLength": 160 } },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["citation", "role", "verified"],
        "properties": {
          "pmid": { "type": "string", "pattern": "^[0-9]{6,9}$" },
          "doi": { "type": "string" },
          "isbn": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "citation": { "type": "string", "maxLength": 400 },
          "role": { "enum": ["primary", "supporting"] },
          "verified": { "type": "boolean" },
          "verified_by": { "type": "string" },
          "open_access": { "enum": ["cc-by", "cc-by-nc", "cc-by-nc-nd", "pmc-oa", "none", "unknown"] },
          "member_author": { "type": "boolean" }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "license", "spec"],
      "properties": {
        "kind": { "enum": ["qeeg_panel", "eeg_page", "aeeg", "composite"] },
        "license": { "enum": ["synthetic-original", "dataset-derived", "consortium", "cc0", "cc-by", "cc-by-sa", "public-domain"] },
        "attribution": { "type": ["string", "null"] },
        "spec": { "type": "object", "required": ["seed"], "properties": { "seed": { "type": "integer" } } },
        "rendered": {
          "type": "object",
          "description": "filled by the renderer, not the writer",
          "properties": {
            "path": { "type": "string" },
            "width": { "type": "integer" },
            "height": { "type": "integer" },
            "spec_hash": { "type": "string" },
            "renderer_version": { "type": "string" }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "created", "source_method", "checklist"],
      "properties": {
        "author": { "type": "string" },
        "model": { "type": "string" },
        "created": { "type": "string", "format": "date" },
        "source_method": { "enum": ["literature-derived", "expert-authored", "ai-generated-pipeline"] },
        "checklist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cover_test", "one_best_answer", "numbers_sourced", "pmids_verified", "acns_terminology", "spec_deterministic", "no_copyright_reuse", "deidentified", "explanation_structure"],
          "properties": {
            "cover_test": { "type": "boolean" },
            "one_best_answer": { "type": "boolean" },
            "numbers_sourced": { "type": "boolean" },
            "pmids_verified": { "type": "boolean" },
            "acns_terminology": { "type": "boolean" },
            "spec_deterministic": { "type": "boolean" },
            "no_copyright_reuse": { "type": "boolean" },
            "deidentified": { "type": "boolean" },
            "explanation_structure": { "type": "boolean" }
          }
        },
        "review": {
          "type": "object",
          "properties": {
            "editor": { "type": ["string", "null"] },
            "decision": { "enum": ["approved", "changes_requested", "rejected", null] },
            "notes": { "type": ["string", "null"] },
            "decided_at": { "type": ["string", "null"] }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "question_type": { "const": "multiple_choice" } } },
      "then": { "properties": { "options": { "minItems": 4 } } }
    },
    {
      "if": { "properties": { "question_type": { "const": "point_to_feature" } } },
      "then": { "required": ["point_to_feature"] }
    }
  ]
}
